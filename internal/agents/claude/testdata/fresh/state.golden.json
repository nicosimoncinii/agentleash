{
  "version": 1,
  "permissionsDeny": [
    "Read(.env)",
    "Read(.env.*)",
    "Read(*.pem)",
    "Read(/certs/*.key)",
    "Read(/config/secrets.yml)",
    "Read(~/.aws/credentials)",
    "Read(//etc/ssl/private/**)",
    "Read(//c/Users/dev/.ssh/id_rsa)",
    "Read(!.env.example)",
    "Edit(.env)",
    "Edit(.env.*)",
    "Edit(*.pem)",
    "Edit(/certs/*.key)",
    "Edit(/config/secrets.yml)",
    "Edit(~/.aws/credentials)",
    "Edit(//etc/ssl/private/**)",
    "Edit(//c/Users/dev/.ssh/id_rsa)",
    "Edit(!.env.example)",
    "Edit(/.agentleash.yaml)",
    "Edit(/.claude/settings.json)",
    "Edit(/.claude/settings.local.json)",
    "Edit(/.claude/agentleash-state.json)",
    "Edit(/.codex/hooks.json)",
    "Edit(/.codex/config.toml)",
    "Edit(~/.claude/settings.json)",
    "Edit(~/.claude/settings.local.json)",
    "Edit(~/.codex/config.toml)",
    "Edit(~/.codex/hooks.json)"
  ]
}
