{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/lint-patch.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/old/path/agentleash hook codex",
            "statusMessage": "agentleash hook: checking tool call"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/audit.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "'/older/agentleash' hook codex"
          }
        ]
      }
    ]
  }
}
