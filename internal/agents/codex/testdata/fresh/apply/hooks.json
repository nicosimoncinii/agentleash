{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/agentleash hook codex",
            "statusMessage": "agentleash hook: checking tool call against .agentleash.yaml"
          }
        ]
      }
    ]
  }
}
